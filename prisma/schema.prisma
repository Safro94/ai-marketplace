// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?  @db.Text
  website       String?
  twitterHandle String?
  githubHandle  String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  totalAssets   Int      @default(0)

  assets                Asset[]
  reviews               Review[]
  purchases             Purchase[]
  creatorProfile        CreatorProfile?
  notifications         Notification[]
  Download              Download[]
  viewedAssets          Asset[]         @relation("ProfileViewedAssets")
  profileAffiliateCodes AffiliateCode[] @relation("ProfileAffiliateCodes")
}

model CreatorProfile {
  id             String                            @id @default(cuid())
  profileId      String                            @unique
  profile        Profile                           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expertise      String
  experience     String
  portfolio      String?
  paymentMethods CreatorApplicationPaymentMethod[]
  commissionRate Float                             @default(25.0) // Default 25%
  isExclusive    Boolean                           @default(false)
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt

  // Relations
  creatorApplication CreatorApplication?
  analytics          CreatorAnalytics?
  affiliateCodes     AffiliateCode[]
}

model AffiliateCode {
  id                 String          @id @default(cuid())
  code               String          @unique
  isDefault          Boolean         @default(false)
  totalUses          Int             @default(0)
  totalSales         Float           @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  discountPercentage Int?            @default(0)
  status             AffiliateStatus @default(ACTIVE)

  profileId        String?
  profile          Profile?        @relation("ProfileAffiliateCodes", fields: [profileId], references: [id], onDelete: SetNull)
  creatorProfileId String?
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  purchases        Purchase[]

  @@index([code])
  @@index([creatorProfileId])
  @@index([profileId])
  @@index([status])
}

model CreatorApplication {
  id               String            @id @default(cuid())
  creatorProfileId String            @unique
  creatorProfile   CreatorProfile    @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  status           ApplicationStatus @default(PENDING)
  fullName         String
  email            String
  website          String?
  expertise        String
  experience       String
  bio              String            @db.Text
  assetTypes       String            @db.Text
  portfolio        String?
  submittedAt      DateTime          @default(now())
  reviewedAt       DateTime?
  reviewNotes      String?           @db.Text

  @@index([status])
}

model CreatorApplicationPaymentMethod {
  id                String          @id @default(cuid())
  provider          PaymentProvider
  accountIdentifier String // The actual identifier (email, wallet address, etc.)
  isDefault         Boolean         @default(false)
  creatorProfile    CreatorProfile? @relation(fields: [creatorProfileId], references: [id])
  creatorProfileId  String?

  @@unique([provider, accountIdentifier])
}

model CreatorAnalytics {
  id               String         @id @default(cuid())
  creatorProfileId String         @unique
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  totalViews       Int            @default(0)
  totalSales       Int            @default(0)
  totalRevenue     Float          @default(0)
  dailyStats       Json?
  weeklyStats      Json?
  monthlyStats     Json?
  assetPerformance Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  iconName    String?
  colorClass  String?
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  assets Asset[]
}

model Asset {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  description      String           @db.Text
  features         String[]         @db.Text
  requirements     String[]         @db.Text
  creatorId        String
  basePrice        Float            @default(0)
  creator          Profile          @relation(fields: [creatorId], references: [id])
  featuredImage    String
  primaryMediaType PrimaryMediaType @default(IMAGE)
  galleryImages    String[]
  assetFile        String
  status           AssetStatus      @default(PENDING_REVIEW)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  useCase          String?
  tags             String[]
  revenue          Float            @default(0)
  averageRating    Float            @default(0)
  moderationNotes  String?
  approvedAt       DateTime?
  totalSales       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  featured         Boolean          @default(false)
  featuredOrder    Int? // Optional field for controlling the order of featured assets

  // Relations
  viewedBy       Profile[]       @relation("ProfileViewedAssets")
  assetLicenses  AssetLicense[]
  reviews        Review[]
  totalReviews   Int             @default(0)
  downloads      Download[]
  assetAnalytics AssetAnalytics?
  favorite       Favorite[]
  PurchaseItem   PurchaseItem[]

  @@index([categoryId])
  @@index([creatorId])
  @@index([status])
  @@index([tags])
}

model Purchase {
  id              String          @id @default(cuid())
  buyerId         String
  buyer           Profile         @relation(fields: [buyerId], references: [id])
  amount          Float // Total amount for all assets in this purchase
  transactionId   String? // PayPal or other payment provider transaction ID
  status          PurchaseStatus  @default(COMPLETED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  paymentProvider PaymentProvider
  paymentDetails  Json?
  discountAmount  Float           @default(0)
  discountType    DiscountType?

  purchaseItems   PurchaseItem[]
  affiliateCodeId String?
  affiliateCode   AffiliateCode? @relation(fields: [affiliateCodeId], references: [id])

  @@index([buyerId])
  @@index([status])
  @@index([affiliateCodeId])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  amount        Float // Individual item price
  licenseKey    String?  @unique
  createdAt     DateTime @default(now())
  commisionRate Int      @default(25) // SERVICE_CHARGE

  // Relations
  downloads      Download[]
  assetLicense   AssetLicense? @relation(fields: [assetLicenseId], references: [id])
  assetLicenseId String?

  @@index([purchaseId])
  @@index([assetId])
}

model License {
  id          LicenseType @id @unique
  name        String
  description String
  features    String[]
  isDefault   Boolean     @default(false)

  // Relations
  assets AssetLicense[]
}

model AssetLicense {
  id        String      @id @default(cuid())
  assetId   String
  asset     Asset       @relation(fields: [assetId], references: [id])
  licenseId LicenseType
  license   License     @relation(fields: [licenseId], references: [id])
  price     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  purchaseItems PurchaseItem[]

  @@unique([assetId, licenseId])
  @@index([assetId])
  @@index([licenseId])
}

model Download {
  id             String       @id @default(cuid())
  purchaseItemId String
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  downloadedAt   DateTime     @default(now())
  ipAddress      String?
  userAgent      String?
  Asset          Asset?       @relation(fields: [assetId], references: [id])
  assetId        String?
  Profile        Profile?     @relation(fields: [profileId], references: [id])
  profileId      String?

  @@index([purchaseItemId])
  @@index([profileId])
}

model Review {
  id            String       @id @default(cuid())
  assetId       String
  asset         Asset        @relation(fields: [assetId], references: [id])
  userProfileId String
  userProfile   Profile      @relation(fields: [userProfileId], references: [id])
  rating        Int
  title         String
  comment       String?
  isVerified    Boolean      @default(false)
  status        ReviewStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([assetId, userProfileId])
  @@index([assetId])
  @@index([userProfileId])
}

model Notification {
  id        String           @id @default(cuid())
  profileId String
  profile   Profile          @relation(fields: [profileId], references: [id])
  title     String
  message   String           @db.Text
  type      NotificationType
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@index([profileId])
  @@index([read])
}

model AssetAnalytics {
  id             String   @id @default(cuid())
  assetId        String   @unique
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uniqueViews    Int      @default(0)
  conversionRate Float    @default(0)
  dailyStats     Json?
  weeklyStats    Json?
  monthlyStats   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  createdAt DateTime @default(now())

  @@unique([profileId, assetId])
  @@index([profileId])
  @@index([assetId])
}

model Testimonial {
  id           String   @id @default(cuid())
  content      String   @db.Text
  authorName   String
  authorRole   String
  authorAvatar String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime  @updatedAt
  role          String    @default("user")
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

enum PaymentProvider {
  PAYPAL
}

enum Role {
  ADMIN
  CREATOR
  USER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssetStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum LicenseType {
  STANDARD
  EXTENDED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum DiscountType {
  AFFILIATE_REFERRAL // From user/creator affiliate code
  FIRST_PURCHASE // First-time buyer discount
  SEASONAL_PROMOTION // Holiday sales, seasonal events
  EMAIL_CAMPAIGN // From email marketing
  LOYALTY_REWARD // For repeat customers
  BUNDLE_DISCOUNT // When buying multiple items
  VOLUME_DISCOUNT // Based on purchase amount
  ADMIN_OVERRIDE // Manually applied by admin
  CREATOR_PROMOTION // Special promotion by a creator
  ABANDONED_CART // Discount to recover abandoned cart
  SOCIAL_MEDIA // From social media campaign
}

enum PrimaryMediaType {
  IMAGE
  VIDEO
}
